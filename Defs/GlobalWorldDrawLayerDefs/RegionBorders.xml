<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Registers the region-border overlay as a global world draw layer (#53). RimWorld 1.6 instantiates
    world draw layers from defs (GlobalWorldDrawLayerDef / per-PlanetLayer), NOT by reflecting over
    WorldDrawLayer subclasses, so a layer class alone is never created. A global layer is drawn on every
    planet layer regardless of the active map mode, which is exactly what the overlay needs. The layer
    itself no-ops unless the "Draw region borders" toggle is on.
  -->
  <!--
    MayRequireAnyOf (#81): the layer class uses MapModeFramework.TileUtilities, so it must not be
    instantiated when neither framework is present. GlobalWorldDrawLayerDef itself is a vanilla type, so
    without this gate the def would load and RimWorld would build the layer, which then type-loads the
    missing framework. Gating on either framework skips the def cleanly when neither is active.
  -->
  <GlobalWorldDrawLayerDef MayRequireAnyOf="NozoMe.MapModeFramework,koth.RealisticPlanets2">
    <defName>SynapseRegionBorders</defName>
    <worldDrawLayer>RegionsAndSocieties.WorldLayer_RegionBorders</worldDrawLayer>
  </GlobalWorldDrawLayerDef>

</Defs>
