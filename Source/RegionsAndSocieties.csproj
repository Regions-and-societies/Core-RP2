<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="GamePath.props" />

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>RegionsAndSocieties</AssemblyName>
        <RootNamespace>RegionsAndSocieties</RootNamespace>
        <LangVersion>9.0</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>..\Assemblies\</OutputPath>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.ScreenCaptureModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.ScreenCaptureModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(HarmonyPath)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        
        <!-- Reference Map Mode Framework -->
        <Reference Include="MapModeFramework">
            <HintPath>$(SteamWorkshopPath)\3296654393\1.6\Assemblies\MapModeFramework.dll</HintPath>
            <Private>false</Private>
        </Reference>
        
        <!--
            No reference to RimSynapse Core, deliberately.

            This mod is the map-mode connector: geography, provinces, ownership, overlays, roads.
            It has to build and run on its own, with nothing but Map Mode Framework.

            Living inhabitants — dwelling generation, residents, residency — moved to the Living World
            companion mod (0.8). R&T keeps only the abstract per-tile population count, which it
            publishes to Core through reflection in RegisterProvidersWithCore(); Living World reads that
            same count. Core stays optional in fact and not just on paper. Do not add this reference
            back; the compiler is the only thing enforcing it.
        -->
    </ItemGroup>

    <!-- .NET Framework reference assemblies via NuGet: lets the build resolve net47x/net48
         from a restore, so only the .NET SDK is needed (no system-wide targeting pack). -->
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
